# --- LLM provider (OpenAI only) ---
OPENAI_API_KEY=

TAMS_ORCHESTRATOR_MODEL=gpt-4.1
TAMS_VERIFIER_MODEL=gpt-4.1
TAMS_EXTRACTOR_MODEL=gpt-4.1-mini
TAMS_RERANKER_MODEL=gpt-4.1-mini
TAMS_EMBEDDING_MODEL=text-embedding-3-small

# If OPENAI_API_KEY is unset, TAMS runs in "fake LLM" mode automatically —
# deterministic stub responses, zero network calls. Useful for dev/tests/CI.

# --- Infra (docker-compose service names by default) ---
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
TAMS_SQLITE_PATH=./data/tams.db

# --- Tier 1: Working Memory ---
TAMS_CONTEXT_WINDOW_TOKENS=128000
TAMS_WORKING_MEMORY_BUDGET_FRACTION=0.65   # trigger compaction at 65% (<=70% per spec)
TAMS_WORKING_MEMORY_MAX_TURNS=200          # hard cap regardless of tokens

# --- Tier 2: Raw Chunk Store ---
TAMS_CHUNK_SIZE_TURNS=3

# --- Tier 3: Fact extractors ---
TAMS_PREFERENCE_BATCH_INTERVAL_TURNS=20
TAMS_EXTRACTOR_CIRCUIT_BREAKER_THRESHOLD=5
TAMS_EXTRACTOR_CIRCUIT_BREAKER_COOLDOWN_S=60

# --- Retrieval ---
TAMS_RETRIEVAL_POOL_SIZE=2000
TAMS_RETRIEVAL_TOP_K=12

# --- Decay ---
TAMS_DECAY_HALF_LIFE_TURNS=200

# --- Cost ---
TAMS_COST_INPUT_PER_1K=0.0
TAMS_COST_OUTPUT_PER_1K=0.0
